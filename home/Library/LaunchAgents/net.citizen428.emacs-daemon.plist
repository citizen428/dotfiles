<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>net.citizen428.emacs-daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/emacs</string>
		<string>--daemon</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LIBRARY_PATH</key>
		<string>/opt/homebrew/lib/gcc/current:/opt/homebrew/opt/libgccjit/lib/gcc/current:/opt/homebrew/lib</string>
		<key>SSH_AUTH_SOCK</key>
		<string>/Users/me/.config/1password/agent.sock</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
